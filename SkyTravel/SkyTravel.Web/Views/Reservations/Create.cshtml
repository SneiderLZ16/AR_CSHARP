@using SkyTravel.Web.Models
@{
    var flights = (IEnumerable<Flight>)ViewBag.Flights;
    var passengers = (IEnumerable<Passenger>)ViewBag.Passengers;
}
<h3>Nueva Reserva</h3>
<div class="card p-3">
<form method="post">
  <div class="row g-3">
    <div class="col-md-6">
      <label class="form-label">Vuelo</label>
      <select name="flightId" class="form-select">
        @foreach (var f in flights)
        {
          <option value="@f.Id">@f.Code — @f.Origin → @f.Destination (@f.DepartureUtc.ToLocalTime()) — Disp: @f.SeatsAvailable</option>
        }
      </select>
    </div>
    <div class="col-md-6">
      <label class="form-label">Pasajero</label>
      <select name="passengerId" class="form-select">
        @foreach (var p in passengers)
        {
          <option value="@p.Id">@p.FullName (@p.Document)</option>
        }
      </select>
    </div>
  </div>
  <div class="mt-3">
    <button class="btn btn-primary">Reservar</button>
    <a class="btn btn-outline-secondary" href="/Reservations">Cancelar</a>
  </div>
</form>
</div>
