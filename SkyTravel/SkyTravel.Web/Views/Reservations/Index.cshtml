@model IEnumerable<SkyTravel.Web.Models.Reservation>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0">Reservas</h3>
  <a class="btn btn-primary" href="/Reservations/Create">Nueva Reserva</a>
</div>

<div class="card p-3">
<table class="table table-hover align-middle mb-0">
  <thead class="table-light"><tr><th>Reserva</th><th>Pasajero</th><th>Vuelo</th><th>Asiento</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
  <tbody>
  @foreach (var r in Model) {
    <tr>
      <td class="fw-semibold">@r.ReservationCode</td>
      <td>@r.Passenger.FullName (@r.Passenger.Document)</td>
      <td>@r.Flight.Code — @r.Flight.Origin → @r.Flight.Destination (@r.Flight.DepartureUtc.ToLocalTime())</td>
      <td>@r.SeatCode</td>
      <td><span class="badge bg-info">@r.Status</span></td>
      <td class="text-end">
        <a class="btn btn-sm btn-outline-info" href="/Reservations/Details/@r.Id">Ver</a>
        <form method="post" action="/Reservations/Cancel/@r.Id" class="d-inline"><button class="btn btn-sm btn-outline-warning">Cancelar</button></form>
        <form method="post" action="/Reservations/Complete/@r.Id" class="d-inline"><button class="btn btn-sm btn-outline-success">Completar</button></form>
        <form method="post" action="/Tickets/Generate?reservationId=@r.Id" class="d-inline"><button class="btn btn-sm btn-dark text-white">PDF</button></form>
      </td>
    </tr>
  }
  </tbody>
</table>
</div>
